NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect and hosted Checkout (use test-mode values while developing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional; defaults to US. Choose a country supported by your Stripe platform.
STRIPE_CONNECT_ACCOUNT_COUNTRY=US

# Optional paid-order email notifications (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sentry error and performance monitoring (get the DSN from your Sentry project)
NEXT_PUBLIC_SENTRY_DSN=
# Optional source map uploads during production builds
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
